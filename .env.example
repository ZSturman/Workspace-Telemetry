# Required only for commands that read or write Notion.
TELEMETRY_NOTION_API_KEY=
TELEMETRY_PROJECTS_DATABASE_ID=
TELEMETRY_WORK_LOG_DATABASE_ID=
TELEMETRY_SUMMARIES_DATABASE_ID=
TELEMETRY_CONTEXT_SWITCHES_DATABASE_ID=

TELEMETRY_TIMEZONE=America/Los_Angeles
