TELEMETRY_CONFIG_PATH=~/Library/Application Support/WorkspaceTelemetry/config.json
TELEMETRY_ACTIVITYWATCH_BASE_URL=http://localhost:5600/api/0
TELEMETRY_LM_STUDIO_ENDPOINT=http://localhost:1234/v1
TELEMETRY_LM_STUDIO_MODEL=google/gemma-4-12b-qat
